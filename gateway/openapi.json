{
  "openapi": "3.0.3",
  "info": {
    "title": "US Government Data API",
    "description": "Unified REST API providing access to 45 US government data endpoints across 13 categories including cybersecurity vulnerability intelligence. Real-time data from NVD, CISA KEV, EPSS, NHTSA, FDA, CFPB, FEMA, NOAA, USGS, SEC, BLS, USDA, EPA, HUD, FAA, CBP, SAM.gov, CourtListener, CDC, WHO, Federal Register, Grants.gov, OpenCorporates, and more.",
    "version": "1.1.0",
    "contact": {
      "name": "MARTC03",
      "url": "https://apify.com/martc03"
    }
  },
  "servers": [
    {
      "url": "https://govdata-api.netlify.app",
      "description": "Production (Netlify Proxy)"
    }
  ],
  "paths": {
    "/api/v1/safety/vehicle-recalls": {
      "get": {
        "operationId": "searchVehicleRecalls",
        "summary": "Search NHTSA Vehicle Safety Recalls",
        "description": "Search NHTSA vehicle safety recalls by make, model, and year. Returns recall campaigns with details on affected vehicles, defect summary, consequences, and remedies.",
        "tags": ["Safety"],
        "parameters": [
          { "name": "make", "in": "query", "schema": { "type": "string" }, "description": "Vehicle make (e.g., FORD, TOYOTA)" },
          { "name": "model", "in": "query", "schema": { "type": "string" }, "description": "Vehicle model (e.g., F-150, CAMRY)" },
          { "name": "modelYear", "in": "query", "schema": { "type": "integer", "minimum": 1966, "maximum": 2027 }, "description": "Model year (default: current year)" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/SuccessResponse" }, "502": { "$ref": "#/components/responses/ErrorResponse" } }
      }
    },
    "/api/v1/safety/fda-recalls": {
      "get": {
        "operationId": "searchFdaRecalls",
        "summary": "Search FDA Product Recalls",
        "description": "Search FDA enforcement actions (recalls) for drugs, food, or medical devices.",
        "tags": ["Safety"],
        "parameters": [
          { "name": "productType", "in": "query", "schema": { "type": "string", "enum": ["drug", "food", "device"] }, "description": "FDA product category" },
          { "name": "searchText", "in": "query", "schema": { "type": "string" }, "description": "Free-text search" },
          { "name": "classification", "in": "query", "schema": { "type": "string" }, "description": "Recall classification (Class I, II, III)" },
          { "name": "status", "in": "query", "schema": { "type": "string" }, "description": "Recall status (Ongoing, Completed, Terminated)" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }, "description": "Results to return" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/SuccessResponse" }, "502": { "$ref": "#/components/responses/ErrorResponse" } }
      }
    },
    "/api/v1/safety/consumer-complaints": {
      "get": {
        "operationId": "searchConsumerComplaints",
        "summary": "Search CFPB Consumer Complaints",
        "description": "Search the CFPB Consumer Complaint Database for complaints against financial companies.",
        "tags": ["Safety"],
        "parameters": [
          { "name": "company", "in": "query", "schema": { "type": "string" }, "description": "Company name" },
          { "name": "product", "in": "query", "schema": { "type": "string" }, "description": "Financial product type" },
          { "name": "state", "in": "query", "schema": { "type": "string" }, "description": "US state abbreviation" },
          { "name": "dateFrom", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Start date (YYYY-MM-DD)" },
          { "name": "dateTo", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "End date (YYYY-MM-DD)" },
          { "name": "searchText", "in": "query", "schema": { "type": "string" }, "description": "Free-text search" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }, "description": "Results to return" }
        ],
        "responses": { "200": { "$ref": "#/components/responses/SuccessResponse" }, "502": { "$ref": "#/components/responses/ErrorResponse" } }
      }
    },
